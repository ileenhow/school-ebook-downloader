{
  "name": "school-ebook-downloader",
  "version": "0.4.0",
  "private": true,
  "description": "Chrome extension for downloading textbooks from SmartEdu pages.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "zip": "node scripts/package-extension.mjs",
    "release:build": "pnpm typecheck && pnpm test && pnpm build && pnpm security:check && pnpm zip",
    "release:version": "node scripts/release-version.mjs",
    "security:check": "node scripts/validate-extension-security.mjs",
    "cws:check": "node scripts/chrome-web-store-publish.mjs --check",
    "cws:upload": "node scripts/chrome-web-store-publish.mjs --no-publish",
    "cws:publish": "node scripts/chrome-web-store-publish.mjs",
    "edge:upload": "node scripts/edge-addons-publish.mjs --no-publish",
    "edge:publish": "node scripts/edge-addons-publish.mjs",
    "clean": "rm -rf dist",
    "security:secrets": "bash .security/gitleaks.sh tree",
    "security:secrets:history": "bash .security/gitleaks.sh history",
    "prepare": "node .security/install-hooks.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.33",
    "@types/node": "^25.9.3",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.10",
    "husky": "9.1.7"
  }
}
